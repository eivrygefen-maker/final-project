{
  "contract_version": "pgsm_step5i_string_partial_damping_refinement_v1",
  "string_partial_damping_contract": {
    "contract_id": "pgsm_string_partial_damping_v1",
    "implements_multi_decay_term": "string_partial_decay_only",
    "not_implemented_terms": [
      "top_plate_decay",
      "back_plate_decay",
      "air_cavity_decay",
      "radiation_decay",
      "bridge_coupling_loss"
    ],
    "step5e_replaced_law": "tau_k = 2.8 / k^0.65 (global, all notes)",
    "pluck_position_ratio": 0.18,
    "partial_amplitude_law": "sin(pi*n*pluck_position)/n",
    "onset_ramp_ms": 4.0,
    "inharmonicity": {
      "level": "L2_fallback_placeholder",
      "b": 0.0002
    },
    "terms": [
      {
        "term": "base_string_decay_by_string_id",
        "formula": "tau_base[string_id] seconds (literature-proxy open-string sustain)",
        "values": {
          "string_6": 3.4,
          "string_5": 3.15,
          "string_4": 2.85,
          "string_3": 2.65,
          "string_2": 2.35,
          "string_1": 2.05
        },
        "source_level": "L2_literature_fallback",
        "units": "seconds",
        "limitations": "Not measured per-string damping; bass strings assigned longer base tau.",
        "blocked_claims": [
          "measured_string_damping",
          "exact_nylon_loss_coefficient"
        ],
        "objective_metric": "tau_base differs across string_id"
      },
      {
        "term": "harmonic_order_loss",
        "formula": "harmonic_factor = k^0.92",
        "source_level": "L2_diagnostic_proxy",
        "units": "dimensionless divisor on tau",
        "limitations": "Steeper than Step 5E k^0.65; not validated against measurements.",
        "blocked_claims": [
          "validated_partial_Q_per_harmonic"
        ],
        "objective_metric": "tau_k decreases monotonically with harmonic order k"
      },
      {
        "term": "frequency_dependent_loss",
        "formula": "freq_factor = 1 + 0.00016 * f_k",
        "source_level": "L2_diagnostic_proxy",
        "units": "dimensionless divisor on tau",
        "limitations": "High-frequency partials lose energy faster; not arbitrary EQ.",
        "blocked_claims": [
          "spectral_eq_shaping"
        ],
        "objective_metric": "higher f_k yields shorter tau_k"
      },
      {
        "term": "fret_contact_loss_proxy",
        "formula": "fret_factor = 1 + 0.028 * fret",
        "source_level": "L2_diagnostic_proxy",
        "units": "dimensionless divisor on tau",
        "limitations": "Fretted notes include modest contact damping vs open strings.",
        "blocked_claims": [
          "measured_fret_contact_impedance"
        ],
        "objective_metric": "fret>0 increases damping vs open string on same string"
      },
      {
        "term": "material_internal_loss_proxy",
        "formula": "material_factor = MATERIAL_INTERNAL_LOSS[string_id]",
        "source_level": "L2_nylon_classical_literature_fallback",
        "units": "dimensionless divisor on tau",
        "limitations": "Treble strings proxy shorter sustain; not measured linear density loss.",
        "blocked_claims": [
          "measured_internal_friction"
        ],
        "objective_metric": "treble string_id has larger material_factor"
      },
      {
        "term": "bridge_nut_boundary_loss_proxy",
        "formula": "boundary_factor = 1 + 0.032 * sqrt(k)",
        "source_level": "L2_diagnostic_proxy",
        "units": "dimensionless divisor on tau",
        "limitations": "Boundary reflection loss increases with partial order proxy.",
        "blocked_claims": [
          "measured_bridge_admittance_per_partial"
        ],
        "objective_metric": "boundary_factor increases with k"
      },
      {
        "term": "combined_partial_tau",
        "formula": "tau_k = tau_base / (harmonic_factor * freq_factor * fret_factor * material_factor * boundary_factor)",
        "source_level": "L2_diagnostic_combined_proxy",
        "units": "seconds",
        "limitations": "Diagnostic physics proxy only; replaces Step 5E global tau_k in Step 5I generator.",
        "blocked_claims": [
          "real_guitar_equivalence",
          "validated_damping_model"
        ],
        "objective_metric": "per-note tau table; high k shorter tau than low k"
      }
    ],
    "blocked_claims": [
      "Measured string damping",
      "Arbitrary EQ",
      "Real-guitar equivalence",
      "Final synthesis readiness"
    ]
  },
