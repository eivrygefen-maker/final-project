{
  "contract_version": "pgsm_step5j_1_guitar_articulation_body_balance_repair_v1",
  "body_weighting_v2_contract": {
    "contract_id": "pgsm_top_back_air_radiation_weighting_v2",
    "supersedes": "pgsm_top_back_air_radiation_weighting_v1",
    "implements_step5g_terms": [
      "top_plate_decay",
      "back_plate_decay",
      "air_cavity_decay",
      "radiation_decay"
    ],
    "not_implemented_terms": [
      "bridge_coupling_loss"
    ],
    "modal_frequencies_unchanged": true,
    "modal_q_tau_unchanged": true,
    "string_damping_unchanged": true,
    "output_weights_only": true,
    "terms": [
      {
        "term": "top_plate_modal_weight",
        "formula": "W_top = W_rad×(top/region)×1.14×rad_band_v2×top_attack_band(f,τ)×top_cluster_damp_comb_risk_only(f)",
        "validation_metric": "top_plate_attack_share improved vs Step 5J; moderate top share ~0.35–0.48"
      },
      {
        "term": "back_plate_modal_weight",
        "formula": "W_back = W_rad×(back/region)×1.11×rad_band_v2×back_warmth(f)×back_hf_rolloff(f>920Hz)",
        "validation_metric": "back warmth without ~0.60 dominance"
      },
      {
        "term": "air_cavity_modal_weight",
        "formula": "W_air = W_air×(air/region)×2.48×rad_band_v2×air_freq_balance(f)",
        "validation_metric": "air_share balanced ~0.20–0.40"
      },
      {
        "term": "radiation_band_weight",
        "formula": "rad_band_v2 + e5_comb_guard on body+rad weights 560-1420Hz",
        "validation_metric": "E5 radiation_sum/final_output comb_score below 0.95"
      },
      {
        "term": "high_note_radiation_coherence_guard",
        "formula": "e5_comb_sensitive_mode_factors from local cluster regularity; applied to wt/wb/wai/wrad",
        "validation_metric": "E5 comb guard verifiable via before/after comb scores"
      },
      {
        "term": "combined_body_radiation_weight",
        "formula": "p_out = conv(F_bridge_v4, h_top+h_back+h_air); radiation_sum from guarded weights",
        "validation_metric": "body_component_balance_score improved"
      }
    ],
    "gains": {
      "top_plate_modal_gain": 1.14,
      "back_plate_modal_gain": 1.11,
      "air_cavity_modal_gain": 2.48,
      "radiation_f_ref_hz": 1280.0,
      "radiation_f_rolloff_exp": 0.96
    }
  }
}
